    "plugin.disableLocal.warning" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move this incompatible local plugin outside discovery to disable loading. Its behavior is not repaired."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将不兼容的本地插件移出自动发现目录以停用加载。此操作不会修复其功能。"
          }
        }
      }
    },
    "plugin.effects.explanation" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This operation may load plugin code or change external state. Undo restores captured files only; it cannot reverse effects outside those files, running services, or remote installation state."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此操作可能加载插件代码或改变外部状态。撤销仅恢复捕获的文件，无法撤销这些文件之外的影响、运行中的服务或远端安装状态。"
          }
        }
      }
    },
    "plugin.health.v1Definition" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This file exports only a named async factory in the v1 style. OpenCode v2 requires a default definition; the current host version and runtime status are not established. Prefer a producer-provided migration. Disabling stops loading and does not restore behavior."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检测到仅导出具名异步工厂的 v1 风格定义。OpenCode v2 需要默认定义；尚未确认当前主机版本或运行状态。请优先采用插件作者提供的迁移方案。停用只会停止加载，不会恢复功能。"
          }
        }
      }
    },
    "plugin.hostFailure.nextSteps" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Review the recorded host error. Complete any required trust or authentication in the host, then rescan and preview a new batch. The snapshot retains the original files and any partial result."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查看已记录的主机错误。如需信任授权或身份验证，请在主机中完成，然后重新扫描并预览新的批次。快照保留了操作前的文件以及部分执行结果。"
          }
        }
      }
    },
    "plugin.preview.explanation" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preview checks the installed host's version and official command support. Trust approval stays in the host."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "预览会检查已安装宿主的版本和官方命令支持情况。信任审批仍由宿主处理。"
          }
        }
      }
    },
    "problem.copyInsteadOfLink.explanation" : {
      "comment" : "Health problem explanation.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An agent keeps its own copy instead of a link to the shared copy, so it misses updates. Link to Shared Copy replaces it with a link."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "某个智能体保存的是独立副本，而不是指向共享副本的链接，因此不会随更新同步。“链接到共享副本”会将其替换为链接。"
          }
        }
      }
    },
    "problem.deadLink.explanation" : {
      "comment" : "Health problem explanation.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These links point to folders that no longer exist, so agents can't load them. Remove deletes only the link."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些链接指向已不存在的文件夹，智能体无法加载。“移除”只删除链接本身。"
          }
        }
      }
    },
    "problem.duplicateName.explanation" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An agent discovers multiple entries with the same skill name at one scope. Some hosts report a conflict even when links point to the same folder. Review the listed agents and paths, then rename or remove the redundant entry."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "智能体在同一层级发现了多个同名技能入口。部分宿主即使遇到指向同一文件夹的链接也会报告冲突。检查列出的智能体和路径，然后重命名或移除多余入口。"
          }
        }
      }
    },
    "problem.leftoverHostDir.explanation" : {
      "comment" : "Health problem explanation.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When a CLI installs skills, it creates a skills folder for every agent it knows, even ones you never installed. These folders hold only links into the shared skills folder; removing them loses no skill, but leaving them makes those agents look installed. Remove deletes the folder (and its parent if that is left empty) and never touches the shared skills."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装技能时，CLI 会为它认识的每个智能体都创建技能文件夹，即使你没有安装那个智能体。这些文件夹只包含指向共享技能文件夹的链接，移除不会丢失任何技能；留着则会让人误以为装了这些智能体。“移除”会删除该文件夹（以及因此变空的上级文件夹），不会改动共享技能文件夹里的技能。"
          }
        }
      }
    },
    "problem.missingSharedCopy.explanation" : {
      "comment" : "Health problem explanation.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The lock file still tracks these skills, but the shared skills folder no longer holds them. Only an agent's own copy or a link into another folder is left, so updates no longer reach them. Reinstall restores the shared copy from the lock's recorded source and turns those copies into links to it; Remove deletes the lock entry along with those copies and links. Both take a snapshot first, so you can undo them."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "锁文件仍记录着这些技能，但共享技能文件夹里已没有它们的副本，只剩智能体自己的副本或指向别处的链接，所以更新不会再作用到它们。“重新安装”会从锁文件记录的来源恢复共享副本，并把这些副本换成指向它的链接；“移除”会删除锁文件条目以及这些副本和链接。两种操作执行前都会先拍快照，可以撤销。"
          }
        }
      }
    },
    "problem.note.explanation" : {
      "comment" : "Health problem explanation.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expected layouts and things worth knowing before you remove a skill. Nothing here needs fixing."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "预期的目录布局，以及删除技能前值得了解的情况。这里的内容无需修复。"
          }
        }
      }
    },
    "problem.orphan.explanation" : {
      "comment" : "Health problem explanation.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No installer recorded where these skills came from, so nothing can update them. Find a source to reinstall them through npx skills, or delete them."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有任何安装器记录这些技能的来源，因此无法更新。可以查找来源并通过 npx skills 重新安装，或者删除它们。"
          }
        }
      }
    },
    "problem.outOfSync.explanation" : {
      "comment" : "Health problem explanation.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copies of the same skill have different contents. The fix keeps the installer's copy and replaces the others. Local edits in those copies are discarded, and the snapshot lets you undo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同一技能的多个副本内容不一致。修复会保留安装器管理的副本并替换其他副本；这些副本中的本地修改会被丢弃（可通过快照撤销）。"
          }
        }
      }
    },
    "problem.ownerConflict.explanation" : {
      "comment" : "Health problem explanation.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "More than one installer claims the same skill, or copies of unknown origin share its name. Choose which owner to keep."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多个安装器声明了同一技能，或存在来源不明、同名的副本。请选择要保留的所有者。"
          }
        }
      }
    },
    "problem.staleLockEntry.explanation" : {
      "comment" : "Health problem explanation.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The installer's lock file still lists these skills, but their folders are gone. Remove clears the entries with npx skills remove and deletes any links still pointing at them."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装器的锁文件仍记录着这些技能，但它们的文件夹已不存在。“移除”会通过 npx skills remove 清理记录，并删除仍指向它们的链接。"
          }
        }
      }
    },
    "problem.unsupportedLock.explanation" : {
      "comment" : "Health problem explanation.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A lock file was written by a newer installer than Sukiru understands. Update Sukiru to manage these skills."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "锁文件由比 Sukiru 所支持版本更新的安装器写入。请更新 Sukiru 以管理这些技能。"
          }
        }
      }
    },
    "quicklook.title %@" : {
      "comment" : "Quick Look panel title: file name.",
      "localizations" : {
