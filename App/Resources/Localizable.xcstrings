    "problem.copyInsteadOfLink.explanation" : {
      "comment" : "Health problem explanation.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An agent keeps its own copy instead of a link to the shared copy, so it misses updates. Link to Shared Copy replaces it with a link."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "某个智能体保存的是独立副本，而不是指向共享副本的链接，因此不会随更新同步。“链接到共享副本”会将其替换为链接。"
          }
        }
      }
    },
    "problem.deadLink.explanation" : {
      "comment" : "Health problem explanation.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These links point to folders that no longer exist, so agents can't load them. Remove deletes only the link."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些链接指向已不存在的文件夹，智能体无法加载。“移除”只删除链接本身。"
          }
        }
      }
    },
    "problem.note.explanation" : {
      "comment" : "Health problem explanation.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expected layouts and standing advisories. Nothing here needs fixing."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "预期的目录布局与常规提示，无需修复。"
          }
        }
      }
    },
    "problem.orphan.explanation" : {
      "comment" : "Health problem explanation.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No installer recorded where these skills came from, so nothing can update them. Find a source to reinstall them through npx skills, or delete them."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有任何安装器记录这些技能的来源，因此无法更新。可以查找来源并通过 npx skills 重新安装，或者删除它们。"
          }
        }
      }
    },
    "problem.outOfSync.explanation" : {
      "comment" : "Health problem explanation.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copies of the same skill have different contents. The fix keeps the installer's copy and replaces the others. Local edits in those copies are discarded, and the snapshot lets you undo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同一技能的多个副本内容不一致。修复会保留安装器管理的副本并替换其他副本；这些副本中的本地修改会被丢弃（可通过快照撤销）。"
          }
        }
      }
    },
    "problem.ownerConflict.explanation" : {
      "comment" : "Health problem explanation.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "More than one installer claims the same skill, or copies of unknown origin share its name. Choose which owner to keep."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多个安装器声明了同一技能，或存在来源不明、同名的副本。请选择要保留的所有者。"
          }
        }
      }
    },
    "problem.staleLockEntry.explanation" : {
      "comment" : "Health problem explanation.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The installer's lock file still lists these skills, but their folders are gone. Remove clears the entries with npx skills remove and deletes any links still pointing at them."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装器的锁文件仍记录着这些技能，但它们的文件夹已不存在。“移除”会通过 npx skills remove 清理记录，并删除仍指向它们的链接。"
          }
        }
      }
    },
    "problem.unsupportedLock.explanation" : {
      "comment" : "Health problem explanation.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A lock file was written by a newer installer than Sukiru understands. Update Sukiru to manage these skills."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "锁文件由比 Sukiru 所支持版本更新的安装器写入。请更新 Sukiru 以管理这些技能。"
          }
        }
      }
    },
    "quicklook.title %@" : {
