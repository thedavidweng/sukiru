    "arbitration.explainer %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' is claimed by both the Vercel and the GitHub ledger. Choose which ledger survives — exactly two options, no default."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”同时被 Vercel 与 GitHub 账本登记。请选择保留哪个账本——只有两个选项，没有默认项。"
          }
        }
      }
    },
    "arbitration.keepVercel.consequence": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-installs from the Vercel lock's recorded source (npx skills add). Consequences: content resets to upstream; local edits are lost; the re-install erases the GitHub frontmatter provenance."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 Vercel 账本记录的来源重新安装（npx skills add）。后果：内容重置为上游版本；本地修改将丢失；重新安装会抹除 GitHub frontmatter 溯源信息。"
          }
        }
      }
    },
    "arbitration.keepGitHub.consequence": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First runs npx skills remove (dangerous deletion — it deletes by name across ownership, which here is the point), then gh skill install --force re-anchors the recorded GitHub provenance. Consequences: content resets to the gh-recorded ref; local edits are lost."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先运行 npx skills remove（危险删除——按名称跨所有权删除，此处正是所需行为），再用 gh skill install --force 按记录的 GitHub 溯源重新锚定。后果：内容重置为 gh 记录的 ref；本地修改将丢失。"
          }
        }
      }
    },
    "arbitration.keepGitHub.needsGH": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unavailable: this choice re-anchors through gh, which is unavailable in this environment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不可用：此选项需要通过 gh 重新锚定，而此环境中 gh 不可用。"
          }
        }
      }
    },
