          }
        }
      }
    },
    "note.githubCompanionRecord %@" : {
      "comment" : "Health note for gh's record of a project-only skill in the Vercel global lock: the skill name.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "gh records %@ in the Vercel ledger's global lock whenever it installs or updates this skill in a project. A bare `npx skills update -g` would act on that record and install the skill at user scope; gh rewrites it anyway, so there is nothing to clean."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "gh 每次在项目中安装或更新该技能时，都会把 %@ 写入 Vercel 账本的全局锁文件。直接运行 `npx skills update -g` 会读取该记录并把技能装到用户范围；gh 总会重写它，因此无需清理。"
          }
        }
      }
    },
    "npx skills (Vercel)" : {
      "shouldTranslate" : false
    },
    "orphan.findSource.help" : {
