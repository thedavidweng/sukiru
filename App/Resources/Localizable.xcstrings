    "capability.unavailableAt %@ %@": {
      "comment": "Capability unavailable with detected version: version, reason.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — unavailable (%2$@)"
