    "consequence.entersVercelLedger" : {
      "comment" : "Batch review note for a new npx install.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "npx skills records the skill in the Vercel lock file: the main copy goes into .agents/skills, and agent folders follow the CLI's default agents."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "npx skills 会将技能登记到 Vercel 锁文件中：主副本放在 .agents/skills，各智能体文件夹按 CLI 默认的智能体范围放置。"
          }
        }
      }
    },
    "consequence.mergeOverwritesCollidingFiles" : {
      "comment" : "Batch review note.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If the upstream content differs from what's on disk, extra local files are kept but files with the same name are overwritten. gh also records the skill by name in the Vercel ledger's global lock (~/.agents/.skill-lock.json), dropping npx's display-only fields there (plugin groups, last selected agents)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果上游内容与磁盘上的不同，多出的本地文件会保留，但同名文件会被覆盖。gh 还会把该技能名写入 Vercel 账本的全局锁文件（~/.agents/.skill-lock.json），并丢弃其中 npx 仅用于展示的字段（插件分组、上次选择的智能体）。"
          }
        }
      }
    },
    "consequence.pinsGitHubSkill %@" : {
      "comment" : "Batch review note: a gh pin re-installs at the ref.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The skill is re-installed pinned to %@: files that differ from that version are overwritten; files added locally are kept. gh also records the skill by name in the Vercel ledger's global lock (~/.agents/.skill-lock.json), dropping npx's display-only fields there (plugin groups, last selected agents)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "技能将被重新安装并固定到 %@：与该版本不同的文件会被覆盖；本地新增的文件会保留。gh 还会把该技能名写入 Vercel 账本的全局锁文件（~/.agents/.skill-lock.json），并丢弃其中 npx 仅用于展示的字段（插件分组、上次选择的智能体）。"
          }
        }
      }
    },
    "consequence.recordsInVercelGlobalLock" : {
      "comment" : "Batch review note: a gh update also writes the Vercel global lock.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "gh also records the skill by name in the Vercel ledger's global lock (~/.agents/.skill-lock.json), dropping npx's display-only fields there (plugin groups, last selected agents)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "gh 还会把该技能名写入 Vercel 账本的全局锁文件（~/.agents/.skill-lock.json），并丢弃其中 npx 仅用于展示的字段（插件分组、上次选择的智能体）。"
          }
        }
      }
    },
    "consequence.removesLockedSkill %@ %@" : {
      "comment" : "Batch review note. The first argument is the skill name, the second a list of paths.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The lock entry for “%1$@” is removed and these are deleted, including copies an agent made itself: %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会移除“%1$@”的锁文件条目，并删除以下位置，包括智能体自己创建的副本：%2$@。"
          }
        }
      }
    },
    "consequence.removesOnlyStaleLockEntry %@" : {
      "comment" : "Batch review note. The argument is the skill name.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the lock entry and dead links named “%@” are removed; no skill files with that name exist in this scope."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只会移除名为“%@”的锁文件条目和失效链接；此范围内不存在该名称的技能文件。"
          }
        }
      }
    },
    "consequence.replacesCopiesWithSharedLinks" : {
      "comment" : "Batch review note.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Local copies are replaced with links to the source's version in the shared skills folder; local edits survive only in the snapshot."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本地副本将被替换为指向共享技能文件夹中来源版本的链接，本地修改只会保留在快照中。"
          }
        }
      }
    },
    "consequence.resetsToGitHubRef" : {
      "comment" : "Batch review note.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Content resets to the ref gh recorded; local edits are lost. gh also records the skill by name in the Vercel ledger's global lock (~/.agents/.skill-lock.json), dropping npx's display-only fields there (plugin groups, last selected agents)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内容将重置为 gh 记录的版本，本地修改会丢失。gh 还会把该技能名写入 Vercel 账本的全局锁文件（~/.agents/.skill-lock.json），并丢弃其中 npx 仅用于展示的字段（插件分组、上次选择的智能体）。"
          }
        }
      }
    },
    "consequence.resetsToUpstream" : {
      "comment" : "Batch review note.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Content resets to the upstream version; local edits are lost."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内容将重置为上游版本，本地修改会丢失。"
          }
        }
      }
    },
    "consequence.resetsToUpstreamErasingGitHubProvenance" : {
      "comment" : "Batch review note.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Content resets to the upstream version; local edits are lost. The reinstall also removes the GitHub provenance from the frontmatter."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内容将重置为上游版本，本地修改会丢失。重新安装还会移除 frontmatter 中的 GitHub 溯源信息。"
          }
        }
      }
    },
    "consequence.restoresSharedCopy %@" : {
      "comment" : "Batch review note. The argument is a list of paths.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The shared copy is reinstalled from the lock's recorded source, and these become links to it (their current content survives only in the snapshot): %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会从锁文件记录的来源重新安装共享副本，以下位置将变成指向它的链接（它们现在的内容只保留在快照中）：%@。"
          }
        }
      }
    },
    "consequence.unpinsAndUpdates" : {
      "comment" : "Batch review note: unpin clears the pin and updates, replacing the files.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The pin is cleared and the skill updates to the latest upstream version; its files are replaced, deleting files added locally. gh also records the skill by name in the Vercel ledger's global lock (~/.agents/.skill-lock.json), dropping npx's display-only fields there (plugin groups, last selected agents)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取消固定并更新到上游最新版本；技能的文件会被整体替换，本地新增的文件会被删除。gh 还会把该技能名写入 Vercel 账本的全局锁文件（~/.agents/.skill-lock.json），并丢弃其中 npx 仅用于展示的字段（插件分组、上次选择的智能体）。"
          }
        }
      }
    },
    "consequence.writesGitHubProvenance %@" : {
      "comment" : "Batch review note for a new gh install. The argument is the agent id.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "gh writes GitHub provenance into the skill's frontmatter (metadata.github-*). Installs for agent %@; GitHub sources only. gh also records the skill by name in the Vercel ledger's global lock (~/.agents/.skill-lock.json), dropping npx's display-only fields there (plugin groups, last selected agents)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "gh 会将 GitHub 溯源信息写入技能的 frontmatter（metadata.github-*）。安装给智能体 %@；仅支持 GitHub 来源。gh 还会把该技能名写入 Vercel 账本的全局锁文件（~/.agents/.skill-lock.json），并丢弃其中 npx 仅用于展示的字段（插件分组、上次选择的智能体）。"
          }
        }
      }
    },
    "consequence.writesGitHubProvenancePinned %@ %@" : {
      "comment" : "Batch review note for a pinned gh install: agent id, then the pinned ref.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "gh writes GitHub provenance into the skill's frontmatter (metadata.github-*). Installs for agent %1$@, pinned to %2$@; GitHub sources only. gh also records the skill by name in the Vercel ledger's global lock (~/.agents/.skill-lock.json), dropping npx's display-only fields there (plugin groups, last selected agents)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "gh 会将 GitHub 溯源信息写入技能的 frontmatter（metadata.github-*）。安装给智能体 %1$@，固定在 %2$@；仅支持 GitHub 来源。gh 还会把该技能名写入 Vercel 账本的全局锁文件（~/.agents/.skill-lock.json），并丢弃其中 npx 仅用于展示的字段（插件分组、上次选择的智能体）。"
          }
        }
