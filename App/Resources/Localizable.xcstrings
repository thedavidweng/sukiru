    "command.warning.deleteLink" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sukiru removes this link directly. The snapshot keeps it."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
