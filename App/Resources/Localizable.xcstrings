    "snapshots.rollback.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sukiru restores captured files and installer records, removes batch-created files, and preserves unrelated later changes. Plugin effects outside captured files and remote state cannot be reversed."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sukiru 会恢复捕获的文件和安装器记录，移除批次创建的文件，并保留无关的后续改动。捕获文件之外的插件影响及远端状态无法撤销。"
          }
        }
      }
    },
