          }
        }
      },
      "comment" : "Batch review note for a direct link deletion."
    },
    "command.warning.deleteOwnerless" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No installer owns this skill, so Sukiru deletes its folder directly. The snapshot keeps a full copy first."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有安装器管理此技能，因此 Sukiru 将直接删除其文件夹。删除前快照会保留完整副本。"
          }
        }
      },
      "comment" : "Batch review note for a direct folder deletion."
    },
    "command.warning.materialize" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This link becomes a standalone copy. Later updates to the shared copy won't reach it."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此链接将变为独立副本，之后对共享副本的更新不会再同步到它。"
          }
        }
      },
      "comment" : "Batch review note."
    },
    "command.warning.relink" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This copy becomes a link to the shared copy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此副本将变为指向共享副本的链接。"
          }
        }
      },
      "comment" : "Batch review note."
    },
    "command.warning.relinkDiverged" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This copy becomes a link to the shared copy. It differs from the shared copy, so its changes are kept only in the snapshot."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此副本将变为指向共享副本的链接。由于它与共享副本不同，其改动只会保留在快照中。"
          }
        }
      },
      "comment" : "Batch review note."
    },
    "command.warning.removeByName %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dangerous deletion: npx skills remove deletes every skill named “%@” in this scope, whichever installer owns it. No other skill with this name was found here."
          }
        },
        "zh-Hans" : {
