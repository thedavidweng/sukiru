    "settings.installAsCopies.footer" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By default, npx skills keeps one shared copy and links each agent to it. With copies, every agent gets its own folder that other updates don't touch."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认情况下，npx skills 只保留一份共享副本，并为每个智能体创建链接。选择副本后，每个智能体拥有独立文件夹，不受其他更新影响。"
