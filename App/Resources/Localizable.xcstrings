      }
    },
    "rollback.recovery.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Post-execution file evidence is incomplete. Choose an action for each captured file. Recovery restores only chosen snapshot files and preserves all unknown paths; directories containing unknown files cannot be replaced."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "执行后的文件证据不完整。请为每个已捕获文件选择操作。恢复仅还原明确选择的快照文件，并保留所有未知路径；包含未知文件的目录不能被替换。"
          }
        }
      }
    },
    "search.noOwnerResults %@" : {
      "comment" : "Search empty state title: the owner filter (a GitHub login) matched no skills.",
