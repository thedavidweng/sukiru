    "rollback.conflicts.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Files changed after execution. Choose snapshot restoration or preservation for each conflict. Unrelated later additions are preserved."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文件在命令执行后发生了变化。请为每个冲突选择恢复快照或保留当前文件。后续新增的无关文件会保留。"
          }
