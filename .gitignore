.DS_Store
# Finder noise inside Fixtures/ is load-bearing test data
# (.DS_Store/.localized must not flip a leftover host to installed). Negate the
# global .DS_Store rule for the whole corpus so future residue fixtures cannot
# silently drop these files.
!Fixtures/**/.DS_Store
!Fixtures/**/.localized

# Xcode / SwiftPM
*.xcodeproj
.build/
DerivedData/

# Build output
dist/
# ... except inside Fixtures/, where a `dist/` directory is load-bearing
# noise-dir fixture data (ignore-list). Negations must follow
# the rule they override (last match wins).
!Fixtures/**/dist/

# Retired Rust/Gino artifacts (implementation preserved on archive/rust-gui)
/target/
/.gino/
target/
.build-clt/

# Website assets copied in by the Pages workflow
/site/assets/icon.webp
/site/assets/screenshot*.webp
/site/assets/screenshot*.jpg
