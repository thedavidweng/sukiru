  "hostCount": 77,
  "ghAgentSource": "ghAgentId is the `gh skill install --agent` value for the host, captured from `gh skill install --help` (gh 2.102.0); null means gh does not accept the host. gh-only values with no skills@1.7.0 host: antigravity2.0.",
  "omittedUpstreamHosts": {
    "eve": "project-only: upstream globalSkillsDir is undefined, which the schema (non-empty globalSkillDirRelative) cannot express",
    "promptscript": "project-only: upstream globalSkillsDir is undefined, which the schema (non-empty globalSkillDirRelative) cannot express"
  },
  "unmodeledUpstreamFields": {
    "showInUniversalPrompt": "false for antigravity, antigravity-cli, deepagents, dexto, firebender, loaf, sarvam-code: hides the host from the CLI's interactive universal-agents prompt only; it does not change getUniversalAgents, so Sukiru does not model it.",
    "createProjectSkillsDirByDefault": "true for claude-code: the CLI creates .claude/skills in a project without an existing .claude dir; install-side only."
  },
  "globalBaseResolution": {
    "Home": "$HOME (fallback $USERPROFILE)",
    "Xdg": "$XDG_CONFIG_HOME if set and non-empty, else $HOME/.config",
    "Env": "$<envHomeVar> if set and non-empty, else $HOME/<envFallbackDir>"
  },
  "pathSemantics": {
    "globalSkillDirRelative": "Relative to the RESOLVED BASE (see globalBaseResolution), NOT to $HOME. Resolved global root = configHome(base) + globalSkillDirRelative (agents.rs:81-97).",
    "projectSkillDir": "Relative to the project root: projectRoot + projectSkillDir (agents.rs:43-45).",
    "detectionMarker": "Tested against the resolved base first, then against $HOME (agents.rs:159-161). Empty string means: test the resolved base itself and do NOT fall through to $HOME.",
    "extraMarkers": "Tested against $HOME only (agents.rs:164-166).",
    "legacyProjectSkillDirs": "Relative to the project root, like projectSkillDir. Dirs the pinned CLI no longer installs into but users may still hold; scanned READ-ONLY (never an install or -a target).",
    "legacyGlobalSkillDirs": "Relative to the RESOLVED BASE, like globalSkillDirRelative. Scanned READ-ONLY when the dir exists; never an install target."
  },
  "detectionOrder": [
    "id == universal -> false",
    "id == codex && marks_installation(/etc/codex) -> true",
    "id == replit -> exists(cwd/.replit)",
    "id == zed -> custom XDG/APPDATA/FLATPAK probe",
    "detectInProject && (marks_installation(cwd/detectionMarker) || marks_installation(cwd/projectSkillDir)) -> true",
    "detectionMarker empty -> marks_installation(resolvedBase)",
    "marks_installation(resolvedBase/detectionMarker) || marks_installation($HOME/detectionMarker) -> true",
    "any extraMarkers: marks_installation($HOME/marker)"
  ],
